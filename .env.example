# Copy to .env.local and adjust. .env.local is gitignored; this file is
# committed and is the canonical list of every key the app reads.

# Where the API lives. A DIFFERENT ORIGIN from this app, always — the two are
# separate services and separate repos, and the browser treats every call as
# cross-origin. This value must appear in the backend's BIB_CORS_ORIGINS
# allowlist or the browser discards every response.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
